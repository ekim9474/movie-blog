---
const { rating } = Astro.props;

const terribleVal = rating <= 20;
const badVal = rating > 20 && rating <= 40;
const okVal = rating > 40 && rating < 70;
const goodVal = rating >= 70 && rating < 90;
const excelVal = rating >= 90;

// console.log(typeof rating);
---

<div
  class:list={[
    "ratingBox",
    { terribleStyle: terribleVal },
    { badStyle: badVal },
    { okStyle: okVal },
    { goodStyle: goodVal },
    { excelStyle: excelVal },
  ]}
>
  <h3>{rating}</h3>
</div>

<style>
  h3 {
    font-size: 0.9rem;
  }

  .ratingBox {
    display: flex;
    flex-direction: column;
    width: 26px;
    height: 26px;
    padding: 1px;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
  }

  .terribleStyle {
    background-color: red;
  }

  .badStyle {
    background-color: #db4c00;
  }

  .okStyle {
    background-color: #daa520;
  }

  .goodStyle {
    background-color: green;
  }

  .excelStyle {
    background-color: blue;
  }

  #captionText {
    font-size: 0.35rem;
  }
</style>
