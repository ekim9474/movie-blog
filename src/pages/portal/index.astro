---
import GenLayout from "../../layouts/GenLayout.astro";
---

<GenLayout title="Miscellaneous Portal">
  <div class="aboutContainer">
    <div class="section">
      <h1>Links Portal</h1>
      <p>
        Since I don't want to crowd the navigation bar, the portal will be a
        repository of other pages.
      </p>
    </div>
    <div class="section">
      <h2>Miscellaneous</h2>
      <ul>
        <li><a href="/schedule">Schedule</a></li>
      </ul>
    </div>
    <div class="section">
      <h2>Resources</h2>
      <ul>
        <li><a href="/resources/critics">Critics</a></li>
        <li><a href="/resources/">Links</a></li>
        <li><a href="/resources/social-media">Social Media</a></li>
      </ul>
    </div>
  </div>

  <style>
    a {
      text-decoration: none;
      color: white;
    }

    .baseImage {
      max-width: 90svw;
      height: auto;
      align-self: center;
    }

    .aboutContainer {
      width: 60%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .section {
      width: 100%;
    }

    @media screen and (min-width: 1020px) {
      .aboutContainer {
        width: 50%;
      }
    }
  </style>
</GenLayout>
