<style>
  a {
    text-decoration: none;
    color: white;
  }

  .baseImage {
    max-width: 90svw;
    height: auto;
    align-self: center;
  }

  .aboutContainer {
    width: 60%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .section {
    width: 100%;
  }

  @media screen and (min-width: 1020px) {
    .aboutContainer {
      width: 50%;
    }
  }
</style>
